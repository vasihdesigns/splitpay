{
  "expo": {
    "name": "SplitPay",
    "slug": "splitpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "splitpay",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e1b4b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitpay.app",
      "infoPlist": {
        "NSContactsUsageDescription": "SplitPay uses your contacts to find friends already on the app and to invite others.",
        "NSCameraUsageDescription": "SplitPay uses the camera to scan receipts and bills.",
        "NSPhotoLibraryUsageDescription": "SplitPay accesses your photo library to import receipt images.",
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e1b4b"
      },
      "package": "com.splitpay.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "SplitPay accesses your photos to import receipt images.",
          "cameraPermission": "SplitPay uses the camera to scan receipts and bills."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "SplitPay uses your contacts to find friends already on the app and to invite others."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
